# Lead Scraper - Environment Variables

# Separate Neon Database (NOT the MVP database)
DATABASE_URL="postgresql://..."

# Fireworks AI
FIREWORKS_API_KEY="your-fireworks-key"

# Telegram Bot
TELEGRAM_BOT_TOKEN="your-bot-token"
TELEGRAM_CHAT_ID="your-chat-id"

# Forum topic thread IDs (optional). Unset means the group's General topic -
# Telegram rejects an explicit thread id of 1, so leave these blank for General.
TELEGRAM_TOPIC_LEADS=""
TELEGRAM_TOPIC_STATUS=""

# Shared secret for the Telegram webhook. lead-scraper-web only; setting it is
# what mounts POST /telegram/webhook.
TELEGRAM_WEBHOOK_SECRET=""

# Actionable lead cards: minimum score, and the per-run cap that stops a good
# Reddit day from flooding the channel.
LEAD_CARD_MIN_SCORE=60
LEAD_CARD_DAILY_CAP=10

# Optional: Enable debug logging
DEBUG=false

LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=<your-langsmith-api-key>
