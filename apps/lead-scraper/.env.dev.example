# Lead Scraper - DEVELOPMENT Environment Variables
# This file shows the structure for .env.dev (development database)

# DEVELOPMENT Neon Database (safe to reset during testing)
# ⚠️ Use a SEPARATE database from production!
DATABASE_URL="postgresql://user:pass@ep-xxx-xxx.us-east-2.aws.neon.tech/lead_scraper_dev?sslmode=require"

# Fireworks AI
FIREWORKS_API_KEY="your-fireworks-key"

# Telegram Bot
# ⚠️ Use a SEPARATE test bot token here. `pnpm bot:dev` long-polls, and
# Telegram deletes the registered webhook when getUpdates starts - pointing it
# at the production token would silently break the deployed bot.
TELEGRAM_BOT_TOKEN="your-test-bot-token"
TELEGRAM_CHAT_ID="your-chat-id"

# Forum topic thread IDs (optional; blank means the General topic)
TELEGRAM_TOPIC_LEADS=""
TELEGRAM_TOPIC_STATUS=""

LEAD_CARD_MIN_SCORE=60
LEAD_CARD_DAILY_CAP=10

# Optional: Enable debug logging
DEBUG=false

# LangSmith (optional)
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your-langsmith-api-key
